# ─── Moteur de rendu IA ────────────────────────────────────────────────
# Un seul fournisseur suffit. Sans clé, l'application tourne en MODE DÉMO.
# AI_PROVIDER=kie            # kie | fal | gemini | demo (auto si vide)

# kie.ai — Nano Banana Pro (recommandé, le moins cher)
KIE_API_KEY=
# fal.ai — Nano Banana Pro edit
FAL_KEY=
# Google AI Studio — Gemini 3 Pro Image (direct Google)
GEMINI_API_KEY=

# Résolution de sortie : 1K | 2K | 4K
RENDER_RESOLUTION=4K
# Nombre de rendus max par appareil (IP) et par jour
RENDER_LIMIT_PER_DAY=20

# ─── Demandes d'estimation (leads) ─────────────────────────────────────
# Webhook (Make, Zapier, n8n, Slack…) qui reçoit chaque demande en JSON
LEAD_WEBHOOK_URL=
# Ou envoi direct par e-mail via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=info@bpcuisines.ch
LEAD_EMAIL_FROM=Visualiseur BP Cuisines <visualiseur@bpcuisines.ch>
